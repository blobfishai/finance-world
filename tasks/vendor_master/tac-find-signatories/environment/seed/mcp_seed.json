 "email_messages": [
  {
   "id": "em-3101",
   "folder": "inbox",
   "from_addr": "mandates@firstnational-sim.example",
   "to_addr": "treasury@contoso-sim.example",
   "subject": "Annual mandate refresh - account USMF-OPER - certification due 6 March",
   "sent_at": "2026-02-27T09:14:00Z",
   "body": "SIMULATION ONLY.\n\nOur annual refresh of the signing mandate on your operating account (USMF-OPER) falls due this week.\n\nPlease return a certified list of the individuals authorised to sign as at 2 March 2026, stating for each one the single-signature limit you wish us to hold. Anyone not on the certified list will be removed from the mandate on receipt, and their payment-release access closed the same day.\n\nWe hold one specimen signature per individual. Where a person acts in more than one capacity for you, that is still one signatory to us - please certify the number of individuals, not the number of internal roles.\n\nCertification is due by close of business Friday 6 March 2026.\n\nMandate Services, First National (SIMULATION)",
   "attachment_name": null,
   "attachment_text": null
  },
  {
   "id": "em-3102",
   "folder": "inbox",
   "from_addr": "a.dawes@contoso-sim.example",
   "to_addr": "treasury@contoso-sim.example",
   "subject": "RE: Annual mandate refresh - account USMF-OPER",
   "sent_at": "2026-03-01T18:42:00Z",
   "body": "SIMULATION ONLY.\n\nI keep the register on the shared drive and I went through it the week before last, so it should be fine to certify straight off it - just take the rows marked Active and send those. I make it seven.\n\nI'll tidy the older rows up after the refresh goes back.\n\nAndre Dawes, Treasury Operations (SIMULATION)",
   "attachment_name": null,
   "attachment_text": null
  }
 ],
