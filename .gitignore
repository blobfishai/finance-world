# build artifacts — never commit exported worlds or task bundles (sibling-repo wart)
dist/
world/build/
*.tar.gz

# sqlite runtime files — commit only pristine seeds, never live state
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm
state.db

# run outputs
.runs/
data/flake/*.json
data/leaderboard/
logs/
*.log

# os / editor
.DS_Store
node_modules/
__pycache__/
*.pyc
.venv/
traces_archive/

# vendored research corpus — 59 shallow checkouts, 1.3 GB, kept on disk as the cited
# fact-source for research/*.md but never committed. INDEX.md (the hand-written map) stays.
research/external/repos/*
!research/external/repos/INDEX.md
